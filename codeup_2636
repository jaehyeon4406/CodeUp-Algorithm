t = int(input())

for _ in range(t):
    n, m = map(int, input().split())
    n_arr = list(map(int, input().split()))
    m_arr = list(map(int, input().split()))

    n_arr.sort()
    m_arr.sort()

    i, j = 0, 0
    cnt = 0
    sum = 0
    while i < n and j < m:
        if n_arr[i] > m_arr[j]:
            cnt += 1
            j += 1
        else:
            i += 1
            sum += cnt
    
    while i < n:
        sum += cnt
        i += 1

    print(sum)